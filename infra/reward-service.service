[Unit]
Description=Unlucky21 Reward Service
Documentation=https://github.com/YOUR_GITHUB_USERNAME/unlucky21
After=network.target postgresql.service bitcoin-unlucky21.service
Requires=postgresql.service

[Service]
User=unlucky21
Group=unlucky21
Type=simple

# DB credentials are NOT stored in this file — loaded from an env file created
# during setup (deploy.sh never overwrites it once it exists):
#   echo DATABASE_URL=postgres://unlucky21:PASS@localhost/unlucky21?sslmode=disable \
#        > /etc/unlucky21/reward-service.env
EnvironmentFile=/etc/unlucky21/reward-service.env

ExecStart=/opt/unlucky21/reward-service

# Creates /var/run/unlucky21/ on each start (tmpfs, cleared at reboot)
RuntimeDirectory=unlucky21
RuntimeDirectoryMode=0750

Restart=on-failure
RestartSec=5
TimeoutStartSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/unlucky21 /run/unlucky21

StandardOutput=journal
StandardError=journal
SyslogIdentifier=reward-unlucky21

[Install]
WantedBy=multi-user.target
