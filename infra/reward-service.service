[Unit]
Description=SoloUnlucky21 Reward Service
Documentation=https://github.com/YOUR_GITHUB_USERNAME/solounlucky21
After=network.target postgresql.service bitcoin-unlucky21.service
Requires=postgresql.service

[Service]
User=unlucky21
Group=unlucky21
Type=simple

# DATABASE_URL must be set — reward service exits if missing
Environment=DATABASE_URL=postgres://unlucky21:REPLACE_WITH_DB_PASSWORD@localhost/unlucky21?sslmode=disable

ExecStart=/opt/unlucky21/reward-service

# Creates /var/run/unlucky21/ on each start (tmpfs, cleared at reboot)
RuntimeDirectory=unlucky21
RuntimeDirectoryMode=0750

Restart=on-failure
RestartSec=5
TimeoutStartSec=30

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/unlucky21

StandardOutput=journal
StandardError=journal
SyslogIdentifier=reward-unlucky21

[Install]
WantedBy=multi-user.target
